#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	install -D -m 755 deployweb $(DESTDIR)/usr/bin/deployweb
	install -D -m 644 deployweb.1 $(DESTDIR)/usr/share/man/man1/deployweb.1
	install -D -m 644 deployweb.bash-completion $(DESTDIR)/usr/share/bash-completion/completions/deployweb

