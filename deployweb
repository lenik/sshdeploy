#!/bin/bash
: ${RCSID:=$Id: deployweb @VER_DT@ - $}
: ${PROGRAM_TITLE:="Website deployment utility"}
: ${PROGRAM_SYNTAX:="[OPTIONS] PROJECT-DIR"}

. shlib-import cliboot
option -c --config =NAME            "Profile name or config file path"
option -h --ssh-host =HOST          "SSH server host"
option -p --ssh-port =PORT          "SSH server port"
option -u --ssh-user =USER          "SSH server user"
option -i --ssh-identity =FILE      "SSH server identity file"
option -V --ssh-visual-host-key     "SSH server visual host key"
option -P --ssh-sudo-pw =PW         "SSH server sudo password"

option -n --server =[protocol://]HOST:PORT "Add vhost binding, both HOST and PORT are optional, protocol defaults to http"
option -r --www-root =DIR           "Root directory where --dir is relative to, default is sites"
option -d --www-dir =DIR            "Remove dir to deploy, relative to www-root, default is project name"
option -C --conf-name =NAME         "Apache config name, default is basename of www-dir"
option -y --priority =NUM           "Priority, default none"
option -O --apache-options =OPTS    "Add apache options"

option -B --always                  "Do clean build always"
option -s --sync-only               "Only sync files, don't configure Apache"

option    --dryrun                  "Dry run, don't deploy files or configure Apache"
option -q --quiet
option -v --verbose
option    --help
option    --version

opt_config_spec=
    ssh_host=
    ssh_port=22
    ssh_user="$USER"
    ssh_identity_file=
    ssh_visual_host_key=yes
    ssh_sudo_pw=

opt_servers=()
opt_conf_name=
opt_www_root=/var/www
opt_www_dir=
opt_apache_options="+Indexes +MultiViews +FollowSymLinks"

opt_build=auto
opt_sync=1
opt_configure=1
opt_dryrun=0

function setopt() {
    case "$1" in
        -c|--config)
            opt_config_spec="$2";;

        -h|--ssh-host)
            ssh_host="$2"
            _port=${ssh_host##*:}
            if [ -n "$_port" ]; then
                ssh_port=$_port
                ssh_host=${ssh_host%:*}
                if [ -z "$ssh_host" ]; then
                    ssh_host="localhost"
                fi
            fi
            ;;
        -p|--ssh-port)
            ssh_port="$2";;
        -u|--ssh-user)
            ssh_user="$2";;
        -i|--ssh-identity)
            ssh_identity_file="$2";;
        -V|--ssh-visual-host-key)
            ssh_visual_host_key=1;;
        -P|--ssh-sudo-pw)
            ssh_sudo_pw="$2";;

        -n|--server)
            opt_servers+=("$2");;
        -r|--www-root)
            opt_www_root="$2";;
        -d|--www-dir)
            opt_www_dir="$2";;
        -C|--conf-name)
            opt_conf_name="$2";;
        
        -B|--always)
            opt_build=always;;
        -s|--sync-only)
            opt_sync=1
            opt_configure=0
            ;;
        -y|--priority)
            opt_priority="$2";;
        
        --dryrun)
            opt_dryrun=1;;
        -q|--quiet)
            LOGLEVEL=$((LOGLEVEL - 1));;
        -v|--verbose)
            LOGLEVEL=$((LOGLEVEL + 1));;
        --help)
            help $1; exit;;
        --version)
            show_version; exit;;
        *)
            quit "invalid option: $1";;
    esac
}

function _log() {
    local level=$1
    shift
    if [ $LOGLEVEL -ge $level ]; then
        echo "$@" >&2
    fi
}

function _log1() { _log 1 "$@"; }
function _log2() { _log 2 "$@"; }

function find_project_root() {
    local dir="$1"
    local current="$dir"
    
    while [ "$current" != "/" ]; do
        if [ -f "$current/package.json" ]; then
            echo "$current"
            return 0
        fi
        current=$(dirname "$current")
    done
    
    return 1
}

function find_config() {
    local config_dir="$HOME/.config/deployweb"
    if [ ! -d "$config_dir" ]; then
        return 1
    fi
    
    local name
    for name in "$@"; do
        if [ -f "$config_dir/$name" ]; then
            echo "$name"
            return 0
        fi
    done
    
    # Find first non-directory file
    local first_file
    first_file=$(find "$config_dir" -maxdepth 1 -type f -print -quit 2>/dev/null)
    
    if [ -n "$first_file" ]; then
        echo "$(basename "$first_file")"
        return 0
    fi
    
    return 1
}

function load_config() {
    local name_or_file="$1"
    local config_dir="$HOME/.config/deployweb"
    local config_file=""
    
    # Check if it's an absolute path or relative path to a file
    if [ -f "$name_or_file" ]; then
        config_file="$name_or_file"
        _log1 "Loading config file: $config_file"
    elif [ -f "$config_dir/$name_or_file" ]; then
        config_file="$config_dir/$name_or_file"
        _log1 "Loading profile: $name_or_file"
    else
        quit "Invalid profile name or config file: $name_or_file"
    fi
    
    # Trim leading/trailing whitespace without touching inner content.
    function trim_ws() {
        local s="$1"
        # trim leading
        s="${s#"${s%%[![:space:]]*}"}"
        # trim trailing
        s="${s%"${s##*[![:space:]]}"}"
        printf '%s' "$s"
    }

    # Read config file
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        
        # Parse key: value
        if [[ "$line" =~ ^[[:space:]]*([^:]+):[[:space:]]*(.+)$ ]]; then
            local key="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"
            key="$(trim_ws "$key")"
            value="$(trim_ws "$value")"
            # Drop CR from CRLF files.
            value="${value%$'\r'}"
            
            case "$key" in
                ssh-host)           ssh_host="$value";;
                ssh-port)           ssh_port="$value";;
                user)               ssh_user="$value";;
                identity-file)      ssh_identity_file="$value";;
                visual-host-key)    ssh_visual_host_key="$value";;
                sudo-pw)            ssh_sudo_pw="$value";;
                
                server)             opt_servers+=("$value");;
                conf-name)          opt_conf_name="$value";;
                www-root)           opt_www_root="$value";;
                www-dir)            opt_www_dir="$value";;
                apache-options)     opt_apache_options="$value";;
                *)
                    _log1 "Unknown config key: $key"
                    ;;
            esac
        fi
    done < "$config_file"
    
    if [ "${#opt_servers[@]}" -eq 0 ]; then
        quit "Profile config missing 'server'"
    fi

    _log2 "SSH:"
    [ -n "$ssh_host" ]              && _log2 "    host: $ssh_host"
    [ -n "$ssh_port" ]              && _log2 "    port: $ssh_port"
    [ -n "$ssh_user" ]              && _log2 "    user: $ssh_user"
    [ -n "$ssh_identity_file" ]     && _log2 "    identity file: $ssh_identity_file"
    [ -n "$ssh_visual_host_key" ]   && _log2 "    visual host key: $ssh_visual_host_key"
    [ -n "$ssh_sudo_pw" ]           && _log2 "    sudo-pw: $ssh_sudo_pw"

    _log2 "Web:"
    for server in "${opt_servers[@]}"; do
        _log2 "    server name: $server"
    done
    [ -n "$opt_conf_name" ]         && _log2 "    apache conf: $opt_conf_name"
    [ -n "$opt_apache_options" ]    && _log2 "    apache options: $opt_apache_options"
    [ -n "$opt_www_root" ]          && _log2 "    www root: $opt_www_root"
    [ -n "$opt_www_dir" ]           && _log2 "    www directory: $opt_www_dir"
}

function build_project() {
    local project_dir="$1"
    
    _log1 "Building project..."
    cd "$project_dir" || quit "Cannot cd to project directory"
    
    if ! command -v pnpm &> /dev/null; then
        quit "pnpm not found in PATH"
    fi
    
    Run pnpm build || quit "Build failed"
    
    if [ ! -d "dist" ]; then
        quit "Build did not create dist/ directory"
    fi
    
    _log1 "Build completed"
}

function build_ssh_opts() {
    local ssh_port="$1"
    local ssh_opts=""
    
    # Add port if specified
    if [ -n "$ssh_port" ]; then
        ssh_opts="$ssh_opts -p $ssh_port"
    fi
    
    # Add identity file if specified
    if [ -n "$ssh_identity_file" ]; then
        ssh_opts="$ssh_opts -i $ssh_identity_file"
    fi
    
    # Add StrictHostKeyChecking based on visual_host_key
    if [ -n "$ssh_visual_host_key" ]; then
        if [ "$ssh_visual_host_key" = "no" ]; then
            ssh_opts="$ssh_opts -o StrictHostKeyChecking=no"
        elif [ "$ssh_visual_host_key" = "yes" ]; then
            ssh_opts="$ssh_opts -o StrictHostKeyChecking=yes"
        fi
    fi
    
    echo "$ssh_opts"
}

function build_ssh_cmd() {
    local ssh_port="$1"
    local ssh_host="$2"
    local ssh_opts
    ssh_opts=$(build_ssh_opts "$ssh_port")
    
    local ssh_cmd="ssh$ssh_opts"
    if [ -n "$ssh_user" ]; then
        echo "$ssh_cmd ${ssh_user}@${ssh_host}"
    else
        echo "$ssh_cmd $ssh_host"
    fi
}

function shell_quote_sq() {
    # Quote string for safe POSIX shell single-quoted context.
    # Example: abc'def -> 'abc'\''def'
    local s="$1"
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

function setup_remote_askpass() {
    local ssh_cmd="$1"
    if [ -n "$ssh_sudo_pw" ]; then
        # Create askpass script on remote server
        local askpass_script="/tmp/deployweb_askpass_$$"
        # Use printf to create the script with proper escaping
        Run $ssh_cmd "printf '%s\n' '#!/bin/sh' 'echo \"\$LC_SUDO_PW\"' > $askpass_script && chmod +x $askpass_script" || return 1
        echo "$askpass_script"
    fi
}

function cleanup_remote_askpass() {
    local ssh_cmd="$1"
    local askpass_script="$2"
    if [ -n "$askpass_script" ]; then
        $ssh_cmd "rm -f $askpass_script" 2>/dev/null || true
    fi
}

function deploy_files() {
    local local_dir="$1"
    local remote_dir="$2"

    local_dir="${local_dir%/}"
    remote_dir="${remote_dir%/}"
    
    _log1 "Deploy $local_dir/ to $ssh_host:$remote_dir/"
    
    # Build SSH options for rsync
    local ssh_opts
    ssh_opts=$(build_ssh_opts "$ssh_port")

    # Build ssh command and ensure remote directory exists before rsync.
    local ssh_cmd
    ssh_cmd=$(build_ssh_cmd "$ssh_port" "$ssh_host")
    Run $ssh_cmd "mkdir -p \"${remote_dir}\"" || quit "Failed to create remote directory: $remote_dir"
    
    # Build rsync SSH command (without host - host goes in remote path)
    local rsync_ssh_cmd="ssh $ssh_opts"
    
    # Build remote path with user if specified
    local remote_target
    if [ -n "$ssh_user" ]; then
        remote_target="${ssh_user}@${ssh_host}:${remote_dir}"
    else
        remote_target="${ssh_host}:${remote_dir}"
    fi
    
    # Execute rsync
    Run rsync -avz --delete -e "$rsync_ssh_cmd" "$local_dir/" "$remote_target/" || quit "Rsync failed"
    
    _log1 "Files deployed"
}

function list_protocols() {
    local svr
    for svr in "${opt_servers[@]}"; do
        local protocol hp=${svr#*://}
        if [ "$hp" == "$svr" ]; then
            protocol="http"
        else
            protocol="${svr%%://*}"
        fi
        echo "$protocol"
    done | sort -u
}

function list_ports() {
    local svr
    for svr in "${opt_servers[@]}"; do
        local protocol hp=${svr#*://}
        if [ "$hp" == "$svr" ]; then
            protocol="http"
        else
            protocol="${svr%%://*}"
        fi
        local host="${hp%:*}"
        local port=""
        if [ "$host" == "$hp" ]; then
            case "$protocol" in
                https) port=443;;
                *)     port=80;;
            esac
        else
            port="${hp##*:}"
        fi
        echo "$port"
    done | sort -nu
}

function list_servers_for() {
    local port_pattern="$1"
    local svr
    for svr in "${opt_servers[@]}"; do
        local protocol hp=${svr#*://}
        if [ "$hp" == "$svr" ]; then
            protocol="http"
        else
            protocol="${svr%%://*}"
        fi
        local host="${hp%:*}"
        local port=""
        if [ "$host" == "$hp" ]; then
            case "$protocol" in
                https) port=443;;
                *)     port=80;;
            esac
        else
            port="${hp##*:}"
        fi
        if [ "$port" == $port_pattern ]; then
            echo "$svr"
        fi
    done | sort -u
}

function print_vhost() {
    local conf_name="$1"
    local port="$2"
    local document_root="$3"
    local apache_opts="$4"
    local server="$5"
    shift 5
    local server_alts=("$@")

    local hp="${server#*://}"
    local host="${hp%:*}"

    local protocol="${server%%://*}"
    if [ "$protocol" == "$server" ]; then
        case "$port" in
            *43) protocol="https";;
            *)   protocol="http";;
        esac
    fi

    echo "<VirtualHost *:$port>"
    echo "    ServerName $host"
    
    for alt in "${server_alts[@]}"; do
        local alt_hp="${alt#*://}"
        local alt_host="${alt_hp%:*}"
        echo "    ServerAlias $alt_host"
    done

    echo
    echo "    ErrorLog \${APACHE_LOG_DIR}/${conf_name}.error.log"
    echo "    CustomLog \${APACHE_LOG_DIR}/${conf_name}.access.log combined"

    echo        
    echo "    DocumentRoot $document_root"
    echo "    <Directory $document_root>"
    echo "        Options $apache_opts"
    echo "        AllowOverride All"
    echo "        Require all granted"
    echo "    </Directory>"

    if [ "$protocol" = "https" ]; then
        echo
        echo "    SSLEngine on"
        # echo "    SSLCertificateFile /etc/ssl/certs/${conf_name}.crt"
        # echo "    SSLCertificateKeyFile /etc/ssl/private/${conf_name}.key"
        echo "    SSLCertificateFile /etc/letsencrypt/live/$host/fullchain.pem"
        echo "    SSLCertificateKeyFile /etc/letsencrypt/live/$host/privkey.pem"
        echo "    Include /etc/letsencrypt/options-ssl-apache.conf"
        echo
        echo "    #SSLOptions +FakeBasicAuth +ExportCertData +StrictRequire"
        echo "    <FilesMatch \"\.(?:cgi|shtml|phtml|php)\$\">"
        echo "            SSLOptions +StdEnvVars"
        echo "    </FilesMatch>"
        echo "    <Directory /usr/lib/cgi-bin>"
        echo "            SSLOptions +StdEnvVars"
        echo "    </Directory>"
    fi
    echo "</VirtualHost>"
}

function configure_apache() {
    local conf_name="$1"
    local doc_root="$2"
    
    _log1 "Configure apache2"
    
    # Build SSH command
    local ssh_cmd
    ssh_cmd=$(build_ssh_cmd "$ssh_port" "$ssh_host")
    
    # Setup remote askpass script if sudo password is configured
    local askpass_script=""
    if [ -n "$ssh_sudo_pw" ]; then
        askpass_script=$(setup_remote_askpass "$ssh_cmd") || quit "Failed to setup remote askpass script"
    fi
    
    # Create Apache virtual host config
    local vhost_config="/etc/apache2/sites-available/${conf_name}.conf"
    
    # Build sudo command
    local sudo_cmd
    if [ -n "$askpass_script" ]; then
        local quoted_pw
        local quoted_askpass
        quoted_pw=$(shell_quote_sq "$ssh_sudo_pw")
        quoted_askpass=$(shell_quote_sq "$askpass_script")
        sudo_cmd="LC_SUDO_PW=$quoted_pw SUDO_ASKPASS=$quoted_askpass sudo -A"
    else
        sudo_cmd="sudo"
    fi
    
    while read protocol _; do
        case "$protocol" in
            https)
                _log1 "Enabling SSL module"
                Run $ssh_cmd "$sudo_cmd a2enmod ssl" || quit "Failed to enable SSL module"
                ;;
        esac
    done < <(list_protocols)
    
    # Create temporary file for VirtualHost config
    local tmp_file=$(mktemp)
    trap "rm -f $tmp_file; cleanup_remote_askpass \"$ssh_cmd\" \"$askpass_script\"" EXIT
    
    # Generate virtual host configurations
    local ports=( $(list_ports) )

    for port in "${ports[@]}"; do
        local servers=( $(list_servers_for "$port") )
        echo >> "$tmp_file"
        print_vhost "$conf_name" "$port" "$doc_root" "$opt_apache_options" \
            "${servers[@]}" >> "$tmp_file"
    done
    
    # Create config file on remote server
    _log2 "Creating Apache config: $vhost_config"
    Run $ssh_cmd "$sudo_cmd tee $vhost_config > /dev/null" < "$tmp_file" || quit "Failed to create Apache config"
    
    # Enable site
    _log2 "Enabling site"
    Run $ssh_cmd "$sudo_cmd a2ensite ${conf_name}.conf" || quit "Failed to enable site"
    
    # Reload Apache
    _log1 "Reloading Apache"
    Run $ssh_cmd "$sudo_cmd systemctl reload apache2" || quit "Failed to reload Apache"
    
    _log1 "Apache configured and reloaded"
    
    # Cleanup
    rm -f "$tmp_file"
    cleanup_remote_askpass "$ssh_cmd" "$askpass_script"
    trap - EXIT
}

function main() {
    local project_dir=.
    if [ $# != 0 ]; then
        project_dir="$1"
    fi
    if [ ! -d "$project_dir" ]; then
        quit "Project directory not found: $project_dir"
    fi
    # Resolve absolute path
    project_dir=$(cd "$project_dir" && pwd)
    project_name=${project_dir##*/}
    
    # Find project root containing package.json
    local project_root
    project_root=$(find_project_root "$project_dir") || quit "Cannot find project root (package.json)"

    _log1 "Project root: $project_root"
    _log1 "Project name: $project_name"
    
    # Load profile/config
    if [ -z "$opt_config_spec" ]; then
        _log1 "No config specified, find one..."
        opt_config_spec=$(find_config "$project_name") || quit "No profile found in ~/.config/deployweb and no config specified (use -c/--config)"
        _log1 "Using config: $opt_config_spec"
    fi

    load_config "$opt_config_spec"
        if [ "${#opt_servers[@]}" -eq 0 ]; then
            opt_servers=( "$project_name.bodz.net" )
        fi
        if [ -z "$ssh_host" ]; then
            ssh_host="${opt_servers[0]}"
        fi
        if [ "${opt_www_root:0:1}" != "/" ]; then
            local ssh_cmd=$(build_ssh_cmd "$ssh_port" "$ssh_host")
            if ! opt_www_root=$( Run $ssh_cmd readlink -f "$opt_www_root" ); then
                quit "Failed to resolve www-root ($opt_www_root)."
            fi
        fi
        if [ -z "$opt_www_dir" ]; then
            opt_www_dir="$project_name"
        fi
        if [ -z "$opt_conf_name" ]; then
            opt_conf_name="${opt_www_dir##*/}"
        fi

    # Build project
    need_build=0
    case "$opt_build" in
        always)
            need_build=1
            ;;
        auto)
            if [ ! -d "$project_root/dist" ]; then
                need_build=1
            fi
            ;;
        never)
            need_build=0
            ;;
    esac
    if [ "$need_build" = 1 ]; then
        build_project "$project_root"
    fi
    
    # Deploy files
    if [ "$opt_sync" = 1 ]; then
        deploy_files "$project_root/dist" "$opt_www_root/$opt_www_dir"
    fi
    
    # Configure Apache
    if [ "$opt_configure" = 1 ]; then
        conf_name="${opt_conf_name:-${project_name}}"
        doc_root="$opt_www_root/$opt_www_dir"
        configure_apache "$conf_name" "$doc_root" "${opt_servers[@]}"
    fi
    
    _log1 "Deployment completed successfully"
}

function Run() {
    if [ "$opt_dryrun" != 1 ]; then
        "$@"
    else
        _log1 "Dry run: $*"
    fi
}

boot "$@"
