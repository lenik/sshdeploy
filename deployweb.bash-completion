# bash completion for deployweb
# To install, copy this file to /etc/bash_completion.d/deployweb
# or source it in your ~/.bashrc

_deployweb() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    opts="-c --config -h --ssh-host -p --ssh-port -u --ssh-user -i --ssh-identity -V --ssh-visual-host-key -P --ssh-sudo-pw -n --server -r --www-root -d --www-dir -C --conf-name -y --priority -O --apache-options -B --always -s --sync-only --dryrun -q --quiet -v --verbose --help --version"
    
    case "${prev}" in
        -c|--config)
            # Complete profile names from ~/.config/deployweb/
            local config_dir="$HOME/.config/deployweb"
            if [ -d "$config_dir" ]; then
                COMPREPLY=($(compgen -W "$(ls -1 "$config_dir" 2>/dev/null)" -- "$cur"))
            fi
            return 0
            ;;
        -h|--ssh-host)
            # Complete hosts from known_hosts (best effort)
            COMPREPLY=($(compgen -A hostname -- "$cur"))
            return 0
            ;;
        -p|--ssh-port|-y|--priority)
            # Suggest common ports and numeric values
            COMPREPLY=($(compgen -W "22 80 443 8080 8443" -- "$cur"))
            return 0
            ;;
        -u|--ssh-user)
            # Complete local users
            COMPREPLY=($(compgen -u -- "$cur"))
            return 0
            ;;
        -i|--ssh-identity)
            # Complete key files
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0
            ;;
        -n|--server)
            # Suggest server binding formats
            COMPREPLY=($(compgen -W "example.com www.example.com:80 https://example.com:443 http://example.com:8080" -- "$cur"))
            return 0
            ;;
        -r|--www-root|-d|--www-dir)
            # Complete local directories as path hints
            COMPREPLY=($(compgen -d -- "$cur"))
            return 0
            ;;
        -C|--conf-name|-O|--apache-options|-P|--ssh-sudo-pw)
            # No completion for free-form values
            return 0
            ;;
    esac
    
    # Complete options or directories
    if [[ ${cur} == -* ]]; then
        COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        return 0
    else
        # Complete directories for PROJECT-DIR
        COMPREPLY=($(compgen -d -- "${cur}"))
        return 0
    fi
}

complete -F _deployweb deployweb

